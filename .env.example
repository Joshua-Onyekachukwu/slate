[TEMPLATE]
# --- Database (Phase 1+2, ADR-004/011/013) — Postgres 16 ---
# Local dev: Docker Compose (docker-compose.yml) → postgres://slate:slate@localhost:5432/slate
# Cloud (deploy, no Docker): Neon/Supabase pooled connection string — see docs/deploy.md
# The LangGraph checkpointer (PostgresSaver, Task 9) uses the same URL.
DATABASE_URL=postgres://slate:slate@localhost:5432/slate

# --- API boot (Task 10) — PostgresSaver + Drizzle Postgres ---
# apps/api and packages/db both use DATABASE_URL (Task 4/10 re-conform). The
# E2E and test suites create their own hermetic DBs (slate_test_*) on demand.
# Cloud hosts (Render/Railway/Fly) inject PORT automatically; the API reads
# process.env.PORT ?? 4000.

# --- Providers (ADR-002) — NVIDIA primary, others optional fallbacks ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-70b
# Phase 3 Block 3 — real media endpoints. Image generation goes through NVIDIA
# Build's OpenAI-compatible /images/generations surface; the quality gate is a
# REAL eval: the generated image is sent to a hosted vision model for a 1–5
# score. Set NVIDIA_IMAGE_EVAL=0 to skip the eval call (cost). Video/voice/music
# stay NOT_SUPPORTED (NVIDIA TTS is gRPC + approval-gated; no verifiable
# OpenAI-compatible video/music endpoint on Build yet).
NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-3.5-large
NVIDIA_EVAL_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_IMAGE_EVAL=1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Auth (Task 2, ADR-022/023) — Clerk-managed, no local auth tables ---
# Auth is env-gated: the app runs in local/demo mode until BOTH keys are set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# --- Web → API ---
# Local: http://localhost:4000 (or 4100 for the demo stack). On Vercel set this
# to the DEPLOYED API URL (e.g. https://slate-api.onrender.com) — it is read at
# build time on the web side.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- CORS (API) — optional production hardening ---
# Unset → the API reflects any request origin (local-first default). Set to a
# comma-separated list to lock it to your deployed web origin(s), e.g.
# https://slate.vercel.app
CORS_ORIGIN=

# --- Tests ---
# 1 = FakeProvider for every provider call (no keys needed); 0 = real providers.
FAKE_PROVIDER=0
# 1 = hermetic stub auth for the enforced-mode E2E (tests/playwright.auth.config.ts):
# fixed bearer tokens (stub-token-a/b) map to fixed user ids, no Clerk needed.
# Test-only — never set in production.
STUB_AUTH=0

# --- Full build only (later tasks) — not defined here ---
# REDIS_URL (BullMQ, ADR-006), R2 credentials (object storage, ADR-005) arrive with their tasks.
