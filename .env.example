# --- Postgres (docker-compose.yml) ---
DATABASE_URL=postgres://videogen:videogen@localhost:5432/videogen

# --- Clerk (ADR-023, managed auth — in scope for Phase 1+2) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Web → API ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Redis (ADR-006, BullMQ broker — worker app) ---
REDIS_URL=redis://localhost:6379

# --- Providers (ADR-002) — NVIDIA primary, others optional fallbacks ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-70b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tests ---
FAKE_PROVIDER=1
