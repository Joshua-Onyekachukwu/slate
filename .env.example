[TEMPLATE]
# --- Database (Phase 1+2, ADR-004/011/013) — Postgres 16 via Docker Compose ---
# Compose credentials: postgres://slate:slate@localhost:5432/slate (docker-compose.yml).
# The LangGraph checkpointer (PostgresSaver, Task 9) uses the same URL.
DATABASE_URL=postgres://slate:slate@localhost:5432/slate

# --- Vertical slice (ADR-024/014) — zero containers, SQLite file storage ---
# Kept until Task 4 (Drizzle Postgres schema) replaces packages/db's SQLite form.
# SQLite file (created on first open by better-sqlite3).
DATABASE_PATH=./data/slate.db

# --- Providers (ADR-002) — NVIDIA primary, others optional fallbacks ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-70b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Auth (Task 2, ADR-022/023) — Clerk-managed, no local auth tables ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# --- Web → API ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Tests ---
# 1 = FakeProvider for every provider call (no keys needed); 0 = real providers.
FAKE_PROVIDER=0

# --- Full build only (later tasks) — not defined here ---
# REDIS_URL (BullMQ, ADR-006), R2 credentials (object storage, ADR-005) arrive with their tasks.
