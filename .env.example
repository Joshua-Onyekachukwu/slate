# --- Vertical slice (ADR-024/014) — zero containers, SQLite file storage ---
# SQLite file (created on first open by better-sqlite3).
DATABASE_PATH=./data/slate.db

# --- Providers (ADR-002) — NVIDIA primary, others optional fallbacks ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-70b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Web → API ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Tests ---
# 1 = FakeProvider for every provider call (no keys needed); 0 = real providers.
FAKE_PROVIDER=0

# --- Full build only (Phase 1+2, NOT used by the slice) ---
# DATABASE_URL (Postgres via Docker), CLERK_SECRET_KEY / NEXT_PUBLIC_CLERK_* (ADR-023),
# REDIS_URL (BullMQ, ADR-006) — those vars are defined in the Phase 1+2 plan, not here.
